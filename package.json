{
  "name": "SkyRivo",
  "version": "1.0.0",
  "private": true,
  "author": "Harold Paulino",
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "typecheck": "tsc --noEmit",
    "pods": "cd ios && bundle exec pod install",
    "build:android:release": "bash scripts/build-install-release.sh --build-only",
    "postinstall": "node scripts/align-gradle-versions.js && node scripts/patch-rn-agp9-library.js",
    "check:android": "node scripts/check-android-config.js",
    "deploy:android:release": "bash scripts/build-install-release.sh",
    "build:ios:release": "bash scripts/build-ios-release.sh"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/geolocation": "^3.4.0",
    "react": "19.1.1",
    "react-native": "0.82.1",
    "react-native-safe-area-context": "^5.6.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native/babel-preset": "0.82.1",
    "@react-native/metro-config": "0.82.1",
    "@react-native/typescript-config": "0.82.1",
    "@types/react": "^19.1.0",
    "typescript": "^5.8.3",
    "@react-native-community/cli": "^20.0.0",
    "@react-native-community/cli-platform-android": "^20.0.0",
    "@react-native-community/cli-platform-ios": "^20.0.0",
    "@types/jest": "^29.5.14"
  },
  "engines": {
    "node": ">=20.19.4"
  }
}
